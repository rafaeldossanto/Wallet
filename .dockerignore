# The repository root is the build context of the Caddy image only (deploy/caddy/Dockerfile): it
# needs app/, site/ and the Caddyfile. Everything else stays out, secrets included.
*
!app/
!site/
!deploy/caddy/

# Not needed for the web build.
app/android/
app/ios/
app/windows/
app/linux/
app/macos/
app/build/
app/.dart_tool/
app/test/
app/tool/
app/.idea/

# Secrets and local settings never go into an image.
**/.env
**/.env.*
**/*.pem
**/*.key
**/secrets/
**/application-local.yml
**/application-local.yaml
