# Wallet's front door. Caddy gets and renews the Let's Encrypt certificates by itself (it needs
# ports 80 and 443 reachable from the internet and both names pointing at this machine).
# {$WALLET_DOMAIN} and {$WALLET_ACME_EMAIL} come from deploy/.env through compose.

{
	email {$WALLET_ACME_EMAIL}

	# Only TCP is published (80 and 443), so HTTP/3 (UDP) would just make clients try and fall back.
	servers {
		protocols h1 h2
	}
}

# The landing page and the waitlist form.
{$WALLET_DOMAIN} {
	root * /srv/site
	encode zstd gzip
	file_server

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Content-Security-Policy "default-src 'self'; connect-src 'self' https://app.{$WALLET_DOMAIN}; img-src 'self' data:; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
	}
}

# The app (Flutter web) and its API: one origin, so the refresh cookie stays SameSite=Strict.
app.{$WALLET_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
	}

	# Everything the BFF answers; the rest is the app.
	@bff path /api/* /email/* /waitlist/* /password/* /livez
	handle @bff {
		reverse_proxy bff:8080
	}

	handle {
		root * /srv/app
		# The router lives in the browser: any path the files do not have opens the app.
		try_files {path} /index.html

		# What names the other files changes with each build, so the browser asks again for these.
		@entry path /index.html /flutter_bootstrap.js /flutter_service_worker.js /version.json
		header @entry Cache-Control "no-cache"

		file_server
	}
}
