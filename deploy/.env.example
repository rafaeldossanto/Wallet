# Wallet em produção (deploy/compose.yaml). Copie para deploy/.env e preencha; o .env não vai para o
# git (o .gitignore barra .env e .env.*; só este .env.example entra). Passo a passo e explicação em
# Docs/Arquitetura/Deploy.md.
#
# Valores com espaço ou caracteres especiais vão entre aspas. Não ponha espaço em volta do "=".
# Veja que o compose lê este arquivo: um valor que ele exige e falta faz o `docker compose` recusar.

# ---------------------------------------------------------------------------
# Domínio e HTTPS
# ---------------------------------------------------------------------------
# Domínio da landing page. O app e a API ficam em app.<WALLET_DOMAIN>; os dois nomes precisam
# apontar (DNS tipo A) para o IP desta máquina antes do primeiro `up`. O domínio entra no build do
# app e da landing: trocar de domínio exige `docker compose build` de novo.
# Para um teste local use localhost (certificado interno do Caddy, o navegador avisa).
WALLET_DOMAIN=wallet.example.com

# E-mail que o Let's Encrypt usa para avisar de problema com o certificado.
WALLET_ACME_EMAIL=voce@example.com

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
# Senha do usuário "wallet" do banco "wallet". O core usa a mesma (não repita em WALLET_DB_*).
# Gere com: openssl rand -base64 33
# Só vale na primeira subida do volume: depois de criado, mudar aqui não muda a senha do banco.
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# Backup (deploy/backup.sh)
# ---------------------------------------------------------------------------
# Pasta do servidor onde ficam os dumps (guarda os últimos 14 dias). Caminho absoluto.
WALLET_BACKUP_DIR=/var/backups/wallet

# Opcional: se definida e a AWS CLI existir, cada dump também vai para o S3. Ex.: s3://meu-bucket/wallet/
# WALLET_BACKUP_S3_URI=

# ---------------------------------------------------------------------------
# Memória da JVM (máquina de 2 GB)
# ---------------------------------------------------------------------------
# Teto do heap de cada serviço. Com 2 GB de RAM o core + bff + postgres + caddy cabem assim; em
# máquina maior, suba o do core primeiro.
CORE_JAVA_OPTS=-Xmx512m
BFF_JAVA_OPTS=-Xmx256m

# ---------------------------------------------------------------------------
# Core e BFF (o MESMO valor nos dois)
# ---------------------------------------------------------------------------
# Segredo compartilhado BFF -> core (header X-Gateway-Key). O core escuta em 0.0.0.0 dentro da rede
# interna do Docker, então a chave tem de ser forte: mínimo 32 caracteres, e sem ela a subida falha.
# Gere com: openssl rand -base64 48
WALLET_GATEWAY_KEY=

# Maior corpo de requisição aceito. Padrão 256KB.
WALLET_MAX_BODY_SIZE=256KB

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# Conexões do pool com o Postgres (padrão 10; o max_connections do Postgres é 100).
WALLET_DB_POOL_SIZE=10

# Termos de Uso e Política de Privacidade que a pessoa aceita no cadastro. WALLET_TERMS_VERSION é o rótulo gravado
# com o aceite (até 32 caracteres): quando o advogado mudar os textos, mude o rótulo e todo mundo aceita de novo no
# app. As páginas já saem da landing, em https://<WALLET_DOMAIN>/termos.html e /privacidade.html; só ponha as URLs
# aqui se forem outras.
WALLET_TERMS_VERSION=2026-10-preliminar
# WALLET_TERMS_URL=https://wallet.example.com/termos.html
# WALLET_PRIVACY_URL=https://wallet.example.com/privacidade.html

# Chaves RS256 do JWT, em texto PEM numa linha só, com \n no lugar das quebras e entre aspas.
# Gere o par (README, "Chaves") e monte a linha com:
#   awk '{printf "%s\\n", $0}' wallet-jwt-private.pem
# Obrigatórias em produção; sem elas o core não sobe. Guarde o par fora do servidor também:
# perdê-lo derruba todas as sessões (não perde dados).
WALLET_JWT_PRIVATE_KEY=
WALLET_JWT_PUBLIC_KEY=

# AES-256 das descrições das transações: base64 de 32 bytes. Obrigatória.
# Gere com: openssl rand -base64 32
# ATENÇÃO: perder esta chave torna ilegíveis as descrições já gravadas. Guarde uma cópia fora do
# servidor (gerenciador de senhas).
WALLET_DATA_KEY=

# E-mail pelo Amazon SES (SMTP): host email-smtp.<região>.amazonaws.com, porta 587, usuário e senha
# SMTP de um usuário IAM (não a access key) e remetente com domínio ou endereço verificado no SES.
# Obrigatórios: WALLET_SMTP_HOST e WALLET_MAIL_FROM.
WALLET_SMTP_HOST=
WALLET_SMTP_PORT=587
WALLET_SMTP_USERNAME=
WALLET_SMTP_PASSWORD=
# STARTTLS (587), SSL (465). NONE é recusado em produção.
WALLET_SMTP_SECURITY=STARTTLS
# Ex.: "Wallet <no-reply@wallet.example.com>"
WALLET_MAIL_FROM=

# Quantas verificações de senha (BCrypt) rodam ao mesmo tempo. 0 = metade dos processadores.
WALLET_PASSWORD_CHECK_CONCURRENCY=0

# Pluggy (Open Finance). Sem as duas, o core sobe mas toda chamada ao provedor responde
# provider.not_configured. Em produção o modo de conexão é sempre PLUGGY_CONNECT (fixo no compose).
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# false numa segunda instância, para só uma agendar a sincronização.
WALLET_SYNC_SCHEDULER_ENABLED=true

# ---------------------------------------------------------------------------
# BFF
# ---------------------------------------------------------------------------
# Proxies em quem o BFF acredita no X-Forwarded-For, para o rate limit contar o IP do cliente e não
# o do Caddy. As redes do Docker ficam em 172.16.0.0/12; o BFF só é alcançável pelo Caddy.
WALLET_TRUSTED_PROXIES=172.16.0.0/12

# ---------------------------------------------------------------------------
# Webhooks da Pluggy (opcional): uma atualização do banco vira uma sincronização logo, em vez de
# esperar as 6 h. O webhook NÃO é assinado: o Wallet o trata só como dica e sempre lê a Pluggy por
# conta própria. Ligado, o BFF só aceita quem mandar o segredo no header X-Wallet-Webhook-Secret.
# Desligado (padrão), a rota /api/webhooks/pluggy responde 404.
# Para ligar: 1) preencha o segredo; 2) WALLET_PLUGGY_WEBHOOKS_ENABLED=true e `docker compose up -d`;
# 3) registre os webhooks na Pluggy, uma vez (comando em Docs/Arquitetura/Deploy.md):
#   docker compose run --rm core --spring.main.web-application-type=none --wallet.webhooks.register=true
# ---------------------------------------------------------------------------
WALLET_PLUGGY_WEBHOOKS_ENABLED=false
# [obrigatório com WALLET_PLUGGY_WEBHOOKS_ENABLED=true; mínimo 32 caracteres] openssl rand -base64 48
# O mesmo valor vale para o BFF (confere) e para o comando de registro (manda para a Pluggy).
WALLET_PLUGGY_WEBHOOK_SECRET=
# IPs ou faixas CIDR de onde a Pluggy chama, separados por vírgula. Vazio = não confere.
WALLET_PLUGGY_WEBHOOK_IPS=

# ---------------------------------------------------------------------------
# O que o compose define sozinho (não precisa estar aqui)
# ---------------------------------------------------------------------------
# SPRING_PROFILES_ACTIVE=prod
# WALLET_CORE_ADDRESS=0.0.0.0
# WALLET_DB_URL, WALLET_DB_USERNAME, WALLET_DB_PASSWORD  (do postgres do compose e de POSTGRES_PASSWORD)
# WALLET_CORE_URL=http://core:8081
# WALLET_CONNECTION_MODE=PLUGGY_CONNECT
# WALLET_PUBLIC_URL=https://app.<WALLET_DOMAIN>
# WALLET_TERMS_URL=https://<WALLET_DOMAIN>/termos.html e WALLET_PRIVACY_URL=https://<WALLET_DOMAIN>/privacidade.html (se não estiverem acima)
# WALLET_WEB_ALLOWED_ORIGINS=https://<WALLET_DOMAIN>,https://app.<WALLET_DOMAIN>
# WALLET_CORE_MANAGEMENT_PORT=9081 e WALLET_BFF_MANAGEMENT_PORT=9080 (padrões; só dentro do container)
