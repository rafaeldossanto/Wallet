# Variáveis de ambiente do Wallet (core e BFF). Este arquivo é só um modelo: copie para
# um gerenciador de segredos ou para variáveis do sistema. Nunca versione valores reais
# (o .gitignore barra .env, .env.*, *.pem e *.key; só este .env.example entra no git).
#
# Em desenvolvimento quase tudo pode ficar vazio: o core e o BFF sobem com padrões locais.
# Em produção, rode os dois com SPRING_PROFILES_ACTIVE=prod: aí as chaves marcadas
# [prod: obrigatória] fazem a subida falhar se faltarem.

# ---------------------------------------------------------------------------
# Perfil
# ---------------------------------------------------------------------------
# SPRING_PROFILES_ACTIVE=prod

# ---------------------------------------------------------------------------
# Core e BFF (o MESMO valor nos dois)
# ---------------------------------------------------------------------------
# Segredo compartilhado BFF -> core, enviado no header X-Gateway-Key em toda chamada.
# O core recusa com 403 qualquer requisição sem ele (só /actuator/health fica aberto).
# Vazio = chave de desenvolvimento conhecida (só na máquina local).
# [prod: obrigatória, no mínimo 32 caracteres, diferente da chave de desenvolvimento]
# Gere com: openssl rand -base64 48
WALLET_GATEWAY_KEY=

# Maior corpo de requisição aceito (wallet.http.max-body-size). Content-Length acima disso
# recebe 413 sem o corpo ser lido; corpo chunked é cortado nesse tamanho durante a leitura.
# Também vale para o Tomcat (max-swallow-size e max-http-form-post-size). Padrão 256KB.
WALLET_MAX_BODY_SIZE=256KB

# ---------------------------------------------------------------------------
# Core (porta 8081)
# ---------------------------------------------------------------------------
# Interface onde o core escuta. Padrão 127.0.0.1: o BFF roda na mesma máquina e a porta nem
# existe fora dela. Com o BFF em outro host (containers, deploy), use 0.0.0.0 e defina também
# WALLET_GATEWAY_KEY: a chave de desenvolvimento é pública e o core a recusa fora do loopback.
WALLET_CORE_ADDRESS=

WALLET_DB_URL=jdbc:postgresql://localhost:5432/wallet_dev
WALLET_DB_USERNAME=wallet
WALLET_DB_PASSWORD=

# Chaves RS256 do JWT (texto PEM ou caminho de arquivo .pem). As duas ou nenhuma.
# Vazias = chave efêmera (sessões caem a cada reinício).
WALLET_JWT_PRIVATE_KEY=
WALLET_JWT_PUBLIC_KEY=

# AES-256 das descrições das transações: base64 de 32 bytes (openssl rand -base64 32).
# Vazia = chave efêmera: o que for gravado fica ilegível depois de reiniciar.
WALLET_DATA_KEY=

# Pluggy. Vazios = o core sobe, mas toda chamada ao provedor responde provider.not_configured.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# MEU_PLUGGY (desenvolvimento, padrão) ou PLUGGY_CONNECT (produção: o item precisa ser do usuário).
WALLET_CONNECTION_MODE=MEU_PLUGGY

# false numa segunda instância, para só uma agendar a sincronização.
WALLET_SYNC_SCHEDULER_ENABLED=true

# ---------------------------------------------------------------------------
# BFF (porta 8080, a única pública)
# ---------------------------------------------------------------------------
WALLET_CORE_URL=http://localhost:8081

# Origens do Flutter Web (CORS com credenciais), separadas por vírgula.
WALLET_WEB_ALLOWED_ORIGINS=http://localhost:5000

# Proxies reversos em quem o BFF acredita no X-Forwarded-For (IPs ou faixas CIDR, separados
# por vírgula), para o rate limit contar o IP do cliente e não o do proxy. Vazio = o IP da
# própria conexão, o header é ignorado (correto quando o BFF fala direto com os clientes).
# Ex.: nginx na mesma máquina -> 127.0.0.1 ; rede Docker -> 172.16.0.0/12
WALLET_TRUSTED_PROXIES=
