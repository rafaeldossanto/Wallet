# Variáveis de ambiente do Wallet (core e BFF). Este arquivo é só um modelo: copie para
# um gerenciador de segredos ou para variáveis do sistema. Nunca versione valores reais
# (o .gitignore barra .env, .env.*, *.pem e *.key; só este .env.example entra no git).
#
# Em desenvolvimento quase tudo pode ficar vazio: o core e o BFF sobem com padrões locais.
# Em produção, rode os dois com SPRING_PROFILES_ACTIVE=prod: aí as chaves marcadas
# [prod: obrigatória] fazem a subida falhar se faltarem.

# ---------------------------------------------------------------------------
# Perfil
# ---------------------------------------------------------------------------
# SPRING_PROFILES_ACTIVE=prod

# ---------------------------------------------------------------------------
# Core e BFF (o MESMO valor nos dois)
# ---------------------------------------------------------------------------
# Segredo compartilhado BFF -> core, enviado no header X-Gateway-Key em toda chamada.
# O core recusa com 403 qualquer requisição sem ele (só a liveness, /livez, fica aberta).
# Vazio = chave de desenvolvimento conhecida (só na máquina local).
# [prod: obrigatória, no mínimo 32 caracteres, diferente da chave de desenvolvimento]
# Gere com: openssl rand -base64 48
WALLET_GATEWAY_KEY=

# Maior corpo de requisição aceito (wallet.http.max-body-size). Content-Length acima disso
# recebe 413 sem o corpo ser lido; corpo chunked é cortado nesse tamanho durante a leitura.
# Também vale para o Tomcat (max-swallow-size e max-http-form-post-size). Padrão 256KB.
WALLET_MAX_BODY_SIZE=256KB

# ---------------------------------------------------------------------------
# Core (porta 8081)
# ---------------------------------------------------------------------------
# Interface onde o core escuta. Padrão 127.0.0.1: o BFF roda na mesma máquina e a porta nem
# existe fora dela. Com o BFF em outro host (containers, deploy), use 0.0.0.0 e defina também
# WALLET_GATEWAY_KEY: a chave de desenvolvimento é pública e o core a recusa fora do loopback.
WALLET_CORE_ADDRESS=

WALLET_DB_URL=jdbc:postgresql://localhost:5432/wallet_dev
WALLET_DB_USERNAME=wallet
WALLET_DB_PASSWORD=

# Conexões do pool com o Postgres (Hikari), por instância do core. Padrão 10. As rotas caras
# (busca e telas compostas, wallet.bulkhead.*) ficam abaixo dele; quem não acha conexão em 3 s
# recebe 503 service.busy. Some as instâncias e confira com o max_connections do Postgres (100).
WALLET_DB_POOL_SIZE=10

# Porta de gestão do core (actuator: saúde com detalhes e readiness, com o banco). Escuta só em
# 127.0.0.1; na porta do core fica só a liveness, /livez. Padrão 9081; igual à do core não sobe.
WALLET_CORE_MANAGEMENT_PORT=9081

# Chaves RS256 do JWT (texto PEM ou caminho de arquivo .pem). As duas ou nenhuma.
# Vazias = chave efêmera (sessões caem a cada reinício), só fora de produção.
# [prod: obrigatórias; sem elas o core não sobe]
WALLET_JWT_PRIVATE_KEY=
WALLET_JWT_PUBLIC_KEY=

# AES-256 das descrições das transações: base64 de 32 bytes (openssl rand -base64 32).
# Vazia = chave efêmera: o que for gravado fica ilegível depois de reiniciar. Só fora de produção.
# [prod: obrigatória; sem ela o core não sobe]
WALLET_DATA_KEY=

# Endereço público do BFF, para onde apontam os links dos e-mails (<url>/email/confirm#token=... e,
# da lista de espera, <url>/waitlist/confirm#token=... e <url>/waitlist/unsubscribe?token=...).
# Vazio = http://localhost:8080, só em desenvolvimento.
# [prod: obrigatória, https]
WALLET_PUBLIC_URL=

# Termos de Uso e Política de Privacidade que a pessoa aceita no cadastro (e de novo, quando mudam).
# WALLET_TERMS_VERSION é o rótulo gravado com o aceite (até 32 caracteres): mudou o texto, mude o rótulo, e
# todo mundo aceita de novo no app. As URLs são as páginas da landing (site/termos.html e site/privacidade.html).
# Vazios = 2026-10-preliminar e as páginas de http://localhost:5181, só em desenvolvimento.
# [prod: as duas URLs apontam para https://<WALLET_DOMAIN>/termos.html e /privacidade.html]
WALLET_TERMS_VERSION=
WALLET_TERMS_URL=
WALLET_PRIVACY_URL=

# E-mail (SMTP de qualquer provedor). No EC2, o natural é o Amazon SES:
#   host email-smtp.<região>.amazonaws.com, porta 587, usuário e senha SMTP de um usuário IAM
#   (não a access key) e um remetente com domínio ou endereço verificado no SES.
# Sem host, fora de produção os e-mails (com os links) vão para o log, só para desenvolvimento.
# [prod: WALLET_SMTP_HOST e WALLET_MAIL_FROM obrigatórios; sem eles o core não sobe]
WALLET_SMTP_HOST=
WALLET_SMTP_PORT=587
WALLET_SMTP_USERNAME=
WALLET_SMTP_PASSWORD=
# STARTTLS (587, padrão), SSL (465) ou NONE (só servidor local de teste; recusado em prod).
WALLET_SMTP_SECURITY=STARTTLS
# Ex.: Wallet <no-reply@seu-dominio.com>
WALLET_MAIL_FROM=

# Quantas verificações de senha (BCrypt) rodam ao mesmo tempo. 0 = metade dos processadores.
# Quem espera mais de 2 s recebe 429 auth.busy, e o resto do Wallet continua com CPU.
WALLET_PASSWORD_CHECK_CONCURRENCY=0

# Pluggy. Vazios = o core sobe, mas toda chamada ao provedor responde provider.not_configured.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# MEU_PLUGGY (desenvolvimento, padrão: aceita item sem dono de qualquer usuário) ou PLUGGY_CONNECT
# (produção: o item precisa ser do usuário). Com SPRING_PROFILES_ACTIVE=prod, só PLUGGY_CONNECT sobe.
WALLET_CONNECTION_MODE=MEU_PLUGGY

# false numa segunda instância, para só uma agendar a sincronização.
WALLET_SYNC_SCHEDULER_ENABLED=true

# Comunicado de abertura da lista de espera. NÃO é configuração do core que atende a API: é um
# comando que roda uma vez no servidor, com o mesmo ambiente do core (banco, WALLET_SMTP_*,
# WALLET_MAIL_FROM, WALLET_PUBLIC_URL), manda o e-mail a quem está confirmado na lista e encerra:
#   java -jar core.jar --spring.main.web-application-type=none \
#     --wallet.waitlist.announce.id=abertura --wallet.waitlist.announce.file=/caminho/mensagem.txt
# (ou WALLET_WAITLIST_ANNOUNCE_ID e WALLET_WAITLIST_ANNOUNCE_FILE, só para essa execução: com as
# duas definidas, o core NÃO sobe como API, manda o comunicado e sai).
# id:   nome do comunicado; quem já recebeu esse id é pulado, então rodar de novo não reenvia.
# file: texto UTF-8; a primeira linha é o assunto, o resto é o corpo. Cada e-mail leva o link de
#       descadastro da própria pessoa.
# WALLET_WAITLIST_ANNOUNCE_ID=
# WALLET_WAITLIST_ANNOUNCE_FILE=
# E-mails por segundo (padrão 1): respeite o limite do provedor de SMTP (SES: o do envio da conta).
WALLET_WAITLIST_ANNOUNCE_RATE_PER_SECOND=1

# ---------------------------------------------------------------------------
# BFF (porta 8080, a única pública)
# ---------------------------------------------------------------------------
WALLET_CORE_URL=http://localhost:8081

# Porta de gestão do BFF (actuator: saúde com detalhes e readiness). Escuta só em 127.0.0.1;
# na porta pública fica só a liveness, /livez, sem token. Padrão 9080; igual à 8080 não sobe.
WALLET_BFF_MANAGEMENT_PORT=9080

# Webhooks da Pluggy (opcional). O webhook NÃO é assinado: é só uma dica para sincronizar logo, e o
# Wallet sempre lê a Pluggy por conta própria. Desligado (padrão), POST /api/webhooks/pluggy responde 404.
# Ligado, o BFF só aceita quem mandar o segredo no header X-Wallet-Webhook-Secret (comparação em
# tempo constante), e o limite é de 60 por minuto por IP (wallet.rate-limit.webhook-limit).
WALLET_PLUGGY_WEBHOOKS_ENABLED=false
# [prod com webhooks ligados: obrigatório, mínimo 32 caracteres; sem ele o BFF não sobe]
# openssl rand -base64 48. O MESMO valor no core, para o comando que registra os webhooks na Pluggy:
#   java -jar core.jar --spring.main.web-application-type=none --wallet.webhooks.register=true
# (ele cria ou atualiza, sem duplicar, os eventos item/updated, item/error, item/deleted e
# transactions/created, /updated e /deleted, apontando para <WALLET_PUBLIC_URL>/api/webhooks/pluggy; o
# core precisa de PLUGGY_CLIENT_ID, PLUGGY_CLIENT_SECRET e WALLET_PUBLIC_URL, e sai quando termina.)
WALLET_PLUGGY_WEBHOOK_SECRET=
# IPs ou faixas CIDR de onde a Pluggy chama, separados por vírgula. Vazio = não confere.
WALLET_PLUGGY_WEBHOOK_IPS=

# Origens permitidas no CORS, separadas por vírgula: o Flutter Web (com credenciais) e a landing
# page, que chama POST /api/waitlist (lista de espera) de outra origem, sem credenciais. Sem a
# origem da landing aqui o navegador bloqueia o formulário "Quero ser avisado".
# Ex.: https://wallet.example.com,https://site.example.com
WALLET_WEB_ALLOWED_ORIGINS=http://localhost:5000

# Proxies reversos em quem o BFF acredita no X-Forwarded-For (IPs ou faixas CIDR, separados
# por vírgula), para o rate limit contar o IP do cliente e não o do proxy. Vazio = o IP da
# própria conexão, o header é ignorado (correto quando o BFF fala direto com os clientes).
# Ex.: nginx na mesma máquina -> 127.0.0.1 ; rede Docker -> 172.16.0.0/12
WALLET_TRUSTED_PROXIES=
